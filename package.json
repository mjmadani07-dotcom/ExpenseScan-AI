{
  "name": "expensescan-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node --import tsx scripts/start-production.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"for (const p of ['dist','server.js','dev-dist']) require('node:fs').rmSync(p,{recursive:true,force:true})\"",
